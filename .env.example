# Copy to `.env` (project) or `~/.zi/agent/.env` (user).
# zi loads both at startup; existing process env wins; cwd/.env beats agent/.env.
# See docs/MODELS.md

# Optional: override agent config root (default ~/.zi/agent)
# ZI_AGENT_DIR=

# Build-time only (Cargo path deps cannot expand these — run the link script after change):
#   ./scripts/link-host-extensions.sh
# ZI_HOST_EXTENSIONS_PATH=   # default ~/.zi/host-extensions
# ZI_SOURCE_PATH=            # default: this zi repo root

# Logging (tracing EnvFilter)
# RUST_LOG=warn

# --- Provider API keys (set what you use) ---

# Anthropic — model: claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

# OpenAI — model: gpt-4.1
OPENAI_API_KEY=

# DeepSeek — model: deepseek-flash (default)
DEEPSEEK_API_KEY=

# Z.AI / 智谱 GLM — glm-4.7-flash / glm-4v-flash (free; either key works)
ZAI_API_KEY=
# GLM_API_KEY=

# OpenRouter — model: openrouter/auto
OPENROUTER_API_KEY=

# Google Generative AI (when using a google catalog model)
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
